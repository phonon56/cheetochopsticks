<?php

/**
 * @file
 * Theme hook for the WastelessCOS landing page.
 */

/**
 * Implements hook_theme().
 */
function wastelesscos_theme($existing, $type, $theme, $path) {
  return [
    'wastelesscos_page' => [
      'variables' => [
        'stats' => [],
      ],
      'template' => 'wastelesscos-page',
    ],
  ];
}
